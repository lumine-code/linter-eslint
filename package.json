{
  "name": "linter-eslint",
  "author": "lumine-code",
  "description": "ESLint linter provider with bundled v8 and v10 support.",
  "repository": "https://github.com/lumine-code/linter-eslint",
  "bugs": {
    "url": "https://github.com/lumine-code/linter-eslint/issues"
  },
  "keywords": [
    "javascript",
    "typescript",
    "jsx",
    "tsx",
    "static-analysis",
    "code-quality"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "lib/main.js",
  "files": [
    "lib",
    "menus",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationHooks": [
    "language-javascript:grammar-used",
    "language-typescript:grammar-used"
  ],
  "activationCommands": {
    "lumine-workspace": [
      "linter-eslint:reload",
      "linter-eslint:lint-projects",
      "linter-eslint:lint-selected"
    ]
  },
  "consumedServices": {
    "linter.registry": {
      "versions": {
        "^1.0.0": "consumeLinterRegistry"
      }
    },
    "ide-client": {
      "versions": {
        "^1.0.0": "consumeIdeClient"
      }
    },
    "busy-signal": {
      "versions": {
        "^1.0.0": "consumeBusySignal"
      }
    },
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    }
  },
  "providedServices": {
    "linter.provider": {
      "versions": {
        "1.0.0": "provideLinter"
      }
    }
  },
  "linter-package": true,
  "configSchema": {
    "useBuiltin": {
      "title": "Use Bundled ESLint",
      "description": "Use bundled ESLint when project doesn't have ESLint installed. Auto-detects v8 or v10 based on config format.",
      "type": "boolean",
      "default": true
    },
    "deleteOnOpen": {
      "title": "Delete Project Lint on File Open",
      "description": "Delete project-wide lint messages for a file when it is opened in the editor. Restart needed.",
      "type": "boolean",
      "default": true
    },
    "debugMode": {
      "title": "Debug Mode",
      "description": "Log ESLint detection info to developer console.",
      "type": "boolean",
      "default": false
    }
  },
  "dependencies": {
    "eslint10": "npm:eslint@^10.8.0",
    "eslint8": "npm:eslint@^8.57.1",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
